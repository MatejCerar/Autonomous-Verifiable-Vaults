# Simulated TEE signer key (throwaway / demo only. NEVER a real key).
# Default is Anvil account #0, whose address is deterministic:
#   0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
TEE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC. The Mystic market snapshot is read from research/market-data.json, so the
# model runs fully offline; the RPC is only used for the live FTSO FLR/USD and
# XRP/USD reads (falls back cleanly if unreachable). Point at Flare mainnet where
# Mystic and the FTSO feeds live, or Coston2 for the deployed controller.
RPC_URL=https://flare-api.flare.network/ext/C/rpc

# Optional: sign via a real TEE node /sign endpoint instead of the local key.
# TEE_SIGN_URL=http://127.0.0.1:7701/sign

# Optional: HTTP port for `serve` (default 8080)
PORT=8080
