# ---- secrets: NEVER commit ----
**/.env
**/.env.local
**/.env.*.local

# ---- the TEE stack (Flare's tee-node + FCC extension scaffold) ----
# It has its own git repos and a local .env holding a private key. Do not
# republish it here. To run the live TEE, place that stack under TEE/ locally
# (see REAL_TEE.md). up.sh builds the TEE image from it.
TEE/

# ---- dependencies / build artifacts ----
# Note: contracts/lib (vendored forge-std + OpenZeppelin, MIT) IS committed so
# `forge build` works from a clean checkout with no extra install step.
**/node_modules/
**/dist/
**/*.tsbuildinfo
contracts/out/
contracts/cache/
contracts/broadcast/
frontend/public/data/

# ---- misc ----
**/*.log
tee-model/last-plan.json
scripts/rejection-tx.signed.json
.DS_Store
